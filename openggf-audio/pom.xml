<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.opensmps</groupId>
        <artifactId>opensmpsdeck-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>openggf-audio</artifactId>
    <name>OpenSMPSDeck - Pinned OpenGGF Audio</name>
    <description>Reproducible OpenGGF audio extraction for the reboot</description>
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>
    <build>
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF/openggf-audio</targetPath>
                <includes>
                    <include>LICENSE.upstream</include>
                    <include>NOTICE.upstream.md</include>
                    <include>LICENSES/**</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../upstream</directory>
                <targetPath>META-INF/openggf-audio</targetPath>
                <includes><include>openggf-audio.lock.json</include></includes>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/java</directory>
                <targetPath>META-INF/openggf-audio/sources</targetPath>
                <includes><include>**/*.java</include></includes>
            </resource>
        </resources>
    </build>
</project>
